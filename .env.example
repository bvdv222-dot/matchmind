# Copy to .env (git-ignored). Names only: values come from `azd env get-values` or your own setup.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_FAST_DEPLOYMENT=        # OpenAI model: live notes, personalisation
FOUNDRY_STRONG_DEPLOYMENT=      # Claude model: recaps, analyst chat

# Agent models: ollama (local, default until Foundry is connected) | foundry
MM_AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
MM_OLLAMA_FAST=qwen2.5:7b-instruct
MM_OLLAMA_STRONG=qwen2.5:7b-instruct   # qwen2.5:14b-instruct if the GPU can hold it alongside the fast model

# match-intel MCP server: set to use a running server over HTTP (else the runner starts one)
MM_MCP_URL=

# Local stand-ins (day 3): bus=memory|eventhubs, store=sqlite|cosmos, broadcaster=websocket|webpubsub
MM_BUS=memory
MM_STORE=sqlite
MM_BROADCASTER=websocket
