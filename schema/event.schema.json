{
  "$defs": {
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 105.0,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One match event. `t` is seconds since the period started; `minute` is 0-based (StatsBomb style, so 45+2 in\nthe first half is 47); `clock` is the broadcast display (\"45+2'\").",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "t": {
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "minute": {
      "minimum": 0,
      "title": "Minute",
      "type": "integer"
    },
    "clock": {
      "title": "Clock",
      "type": "string"
    },
    "type": {
      "enum": [
        "period_start",
        "period_end",
        "pass",
        "carry",
        "take_on",
        "pressure",
        "tackle",
        "interception",
        "clearance",
        "aerial_duel",
        "ball_recovery",
        "shot",
        "save",
        "foul",
        "card",
        "substitution",
        "offside",
        "ball_out"
      ],
      "title": "Type",
      "type": "string"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtype"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "complete",
            "incomplete",
            "out",
            "offside",
            "goal",
            "saved",
            "blocked",
            "off_target",
            "post",
            "won",
            "lost",
            "neutral",
            "held",
            "parried"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "related_player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "receiver, opponent in a duel, player fouled, sub on",
      "title": "Related Player Id"
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "body_part": {
      "anyOf": [
        {
          "enum": [
            "left_foot",
            "right_foot",
            "head",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Part"
    },
    "speed_kmh": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ball speed for passes and shots",
      "title": "Speed Kmh"
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ball travel / carry time; `t` is when the action starts",
      "title": "Duration S"
    },
    "possession": {
      "description": "possession counter; increments when the team in control changes",
      "minimum": 0,
      "title": "Possession",
      "type": "integer"
    },
    "possession_team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Possession Team Id"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "seq",
    "period",
    "t",
    "minute",
    "clock",
    "type",
    "possession"
  ],
  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bvdv222-dot/matchmind/schema/event.schema.json"
}
